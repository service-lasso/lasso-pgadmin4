{
  "id": "pgadmin4",
  "name": "pgAdmin 4",
  "description": "Release-backed pgAdmin 4 web UI for app-owned PostgreSQL services.",
  "version": "9.14",
  "enabled": false,
  "execservice": "@python",
  "endpoints": [
    {
      "id": "ui",
      "kind": "network",
      "label": "pgAdmin UI",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "http",
      "bind": "127.0.0.1",
      "port": {
        "default": 8510,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "ui_url",
      "kind": "url",
      "label": "pgAdmin UI",
      "target": "ui",
      "url": "http://${endpoint.ui.bind}:${endpoint.ui.port}/",
      "exposure": "local",
      "primary": true
    },
    {
      "id": "health",
      "kind": "url",
      "label": "Health",
      "target": "ui",
      "url": "http://${endpoint.ui.bind}:${endpoint.ui.port}/healthcheck",
      "exposure": "local",
      "required": true
    }
  ],
  "env": {
    "PGADMIN_HOST": "${endpoint.ui.bind}",
    "PGADMIN_PORT": "${endpoint.ui.port}",
    "PGADMIN_SCRIPT_HOME": "${SERVICE_ARTIFACT_ROOT}/python-packages/pgadmin4",
    "DATA_DIR": "${SERVICE_DATA_PATH}",
    "PGADMIN_SERVER_MODE": "OFF",
    "PGADMIN_DEFAULT_EMAIL": "admin@service-lasso.local",
    "PGADMIN_DEFAULT_PASSWORD": "service-lasso",
    "CONSOLE_LOG_LEVEL": "INFO",
    "FILE_LOG_LEVEL": "INFO",
    "PYTHONUTF8": "1"
  },
  "globalenv": {
    "PGADMIN_URL": "${endpoint.ui_url.url}",
    "PGADMIN_PORT": "${endpoint.ui.port}"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-pgadmin4",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-pgadmin4-9.14-win32.zip",
        "archiveType": "zip",
        "command": "./lasso-pgadmin4.py",
        "args": []
      }
    }
  },
  "commandline": {
    "win32": "${SERVICE_ARTIFACT_ROOT}/lasso-pgadmin4.py"
  },
  "setup": {
    "steps": {
      "prepare-data": {
        "description": "Create pgAdmin runtime data directories and validate packaged pgAdmin modules.",
        "execservice": "@python",
        "commandline": {
          "win32": "${SERVICE_ARTIFACT_ROOT}/lasso-pgadmin4.py --setup"
        },
        "timeoutSeconds": 120,
        "rerun": "ifMissing"
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./runtime/data/.keep",
        "content": ""
      },
      {
        "path": "./runtime/logs/.keep",
        "content": ""
      }
    ]
  },
  "logs": {
    "default": {
      "path": "runtime/data/pgadmin4.log"
    }
  },
  "healthchecks": [
    {
      "id": "http-health",
      "type": "http",
      "url": "http://${endpoint.ui.bind}:${endpoint.ui.port}/healthcheck",
      "expected_status": 200,
      "retries": 180,
      "interval": 500
    }
  ],
  "depend_on": [
    "@python",
    "postgres"
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  },
  "meta": {
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-pgadmin4.git"
    },
    "documentationUrl": "https://github.com/service-lasso/lasso-pgadmin4/blob/main/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-pgadmin4/issues",
    "tags": [
      "service-lasso",
      "postgres",
      "pgadmin4",
      "database-admin"
    ]
  }
}
